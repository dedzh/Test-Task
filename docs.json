{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "intern-test-task",
    "license": {"name": "MIT"}
  },
  "servers": [{"url": "http://127.0.0.1:5000"}],
  "paths": {
    "/delete": {
      "delete": {
        "summary": "Delete post by id",
        "parameters": [
          {
            "name": "id",
            "description": "ID of post",
            "required": true,
            "in": "query",
            "schema": {"type": "integer", "format": "int32"}
          }
        ],
        "responses": {
          "200": {"description": "True if deleted, error message otherwise"},
          "400": {"description": "Invalid id"},
          "404": {"description": "Post not found"}
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Returns first 20 posts which contain search query, sorted by created_date desc",
        "parameters": [
          {
            "name": "text",
            "description": "Text in posts to look for",
            "required": true,
            "in": "query",
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "JSON array with posts data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/Docs"}
                }
              }
            }
          },
          "400": {"description": "Bad request"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Docs": {
        "type": "object",
        "properties": {
          "id": {"type": "integer", "format": "int32"},
          "text": {"type": "string"},
          "created_date": {"type": "string"},
          "rubrics": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}